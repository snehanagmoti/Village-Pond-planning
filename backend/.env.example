# Runtime
APP_ENV=development
APP_NAME=Village Pond Planning API
LOG_LEVEL=INFO
ENABLE_API_DOCS=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# PostgreSQL (used only when history is enabled, unless DATABASE_URL is set)
DB_USER=postgres
DB_PASSWORD=replace-with-a-strong-password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=village_pond
HISTORY_ENABLED=false
HISTORY_API_KEY=

# External-source behavior
EXTERNAL_TIMEOUT_SECONDS=25
EXTERNAL_RETRY_COUNT=2
EXTERNAL_RETRY_MAX_DELAY_SECONDS=30
SOURCE_CACHE_TTL_SECONDS=3600
ELEVATION_API_URL=https://api.open-meteo.com/v1/elevation
# Bounded open-data fallback used only when the primary DEM source is unavailable.
ELEVATION_FALLBACK_ENABLED=true
ELEVATION_TILE_URL=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png
ELEVATION_TILE_ZOOM=12
ELEVATION_TILE_MAX_COUNT=16
ELEVATION_TILE_MAX_BYTES=2097152
RAINFALL_API_URL=https://archive-api.open-meteo.com/v1/archive
RAINFALL_FALLBACK_ENABLED=true
RAINFALL_FALLBACK_URL=https://power.larc.nasa.gov/api/temporal/daily/point
RAINFALL_MAX_RESPONSE_BYTES=5242880
OPEN_METEO_API_KEY=
# Set true in production only after confirming the applicable Open-Meteo plan/terms.
OPEN_METEO_USE_AUTHORIZED=false
GEOCODING_USER_AGENT=VillagePondPlanning/2.0 (+mailto:operator@example.org)
GEOCODING_URL=https://nominatim.openstreetmap.org/search
GEOCODING_MIN_INTERVAL_SECONDS=1.05
IMAGERY_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
IMAGERY_SOURCE_NAME=Esri World Imagery
IMAGERY_LICENSE_URL=https://www.esri.com/en-us/legal/terms/full-master-agreement
# Set true in production only after the operator confirms applicable imagery rights.
IMAGERY_USE_AUTHORIZED=false

# Analysis quality and limits
ANALYSIS_MAX_RADIUS_KM=5
ELEVATION_GRID_MIN=23
ELEVATION_GRID_MAX=121
# The public Open-Meteo tier counts coordinate locations toward its 600/minute limit.
# 23×23 = 529 locations; reserved/self-hosted endpoints can keep the higher grid maximum.
ELEVATION_PUBLIC_GRID_MAX=23
ELEVATION_CONCURRENCY=4
# Space DEM batch starts to avoid burst-throttling by the public API.
ELEVATION_MIN_INTERVAL_SECONDS=0.25
RAINFALL_START_YEAR=1991
RAINFALL_END_YEAR=2025
RAINFALL_MODEL=era5_land
RAINFALL_MIN_VALID_YEARS=20
RATE_ANALYZE_PER_MINUTE=6
RATE_CONTOUR_PER_MINUTE=6
RATE_SEARCH_PER_MINUTE=20
RATE_HISTORY_PER_MINUTE=30

# Uploaded contour map limits and contour-derived DEM resolution.
CONTOUR_MAX_UPLOAD_BYTES=15728640
CONTOUR_MAX_UNCOMPRESSED_BYTES=31457280
CONTOUR_KMZ_MAX_ENTRIES=50
CONTOUR_MAX_LINES=20000
CONTOUR_MAX_POINTS=1000000
CONTOUR_GRID_MIN=49
CONTOUR_GRID_MAX=181
CONTOUR_INTERPOLATION_ITERATIONS=800
CONTOUR_CANDIDATE_BOUNDARY_SETBACK_M=75
CONTOUR_DETECTED_WATER_SETBACK_M=60
CONTOUR_CANDIDATE_OPTION_COUNT=3

# Engineering assumptions. Leave authority-dependent values blank until approved.
APPROVED_RUNOFF_COEFFICIENT=
APPROVED_RUNOFF_COEFFICIENT_SOURCE=
DESIGN_RAINFALL_INTENSITY_MM_H=
CAPTURE_EFFICIENCY=0.80
POND_MIN_WATER_DEPTH_M=2.0
POND_MAX_WATER_DEPTH_M=4.0
POND_FREEBOARD_M=0.5
POND_SIDE_SLOPE_H_TO_V=2.0
POND_LENGTH_WIDTH_RATIO=1.5
