# Leave empty for same-origin /api in production or Vite's development proxy.
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT_MS=60000
VITE_DEV_API_TARGET=http://127.0.0.1:8000
VITE_IMAGERY_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
VITE_IMAGERY_ATTRIBUTION=Source: Esri, Maxar, Earthstar Geographics, and the GIS User Community
